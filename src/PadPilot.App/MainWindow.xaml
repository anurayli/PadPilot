<Window x:Class="PadPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PadPilot.App"
        Title="PadPilot" Width="1200" Height="800" MinWidth="980" MinHeight="620"
        Icon="padpilot.ico" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Kenar menusu -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,20">
                    <Image Source="padpilot.ico" Width="32" Height="32" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PadPilot" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{local:L Tagline}" Style="{StaticResource Muted}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,10,18,18">
                    <TextBlock Text="{local:L ActiveProfile}" Style="{StaticResource Muted}" Margin="2,0,0,6" />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                    <StackPanel Orientation="Horizontal" Margin="4,14,0,0">
                        <Ellipse Width="8" Height="8" Fill="{Binding DriverBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DriverStatus}" Style="{StaticResource Muted}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" SelectionChanged="Nav_SelectionChanged"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>

        <!-- Icerik -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="36,26,36,10">
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Pads}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="PadChips" Margin="8,0,0,0" Cursor="Hand" Checked="PadChip_Checked" Loaded="PadChip_Loaded"
                                         Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ConnectionIcon}" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding Name}" Margin="8,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BatteryIcon}" Style="{StaticResource Icon}" FontSize="14" Foreground="{Binding BatteryBrush}" />
                                    <TextBlock Text="{Binding Battery}" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" />
                    <TextBlock x:Name="PageSub" Style="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="36,8,36,28" MaxWidth="1000" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource Card}" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                            x:Name="AutoNote" Padding="16,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" />
                            <TextBlock Text="{Binding AutoProfileNote}" Margin="10,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ContentControl x:Name="PageHost" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
