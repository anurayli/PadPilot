<Window x:Class="PadPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PadPilot" Width="780" Height="560" MinWidth="700" MinHeight="360"
        Background="#14161A" Foreground="#E8EAED" FontFamily="Segoe UI" FontSize="14">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="PadPilot" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" Foreground="#9AA0A6" TextWrapping="Wrap" />
        </StackPanel>
        <Grid>
            <TextBlock x:Name="EmptyText" Foreground="#9AA0A6" FontSize="16" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Text="Pad bekleniyor…&#10;PS4 veya PS5 pad'ini Bluetooth ya da kabloyla bağla." />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PadList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E2126" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding BatteryText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Info}" Foreground="#9AA0A6" />
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Border Width="72" Height="72" CornerRadius="36" Background="#2A2E35">
                                            <Canvas>
                                                <Ellipse Width="10" Height="10" Fill="#4C8DFF" Canvas.Left="{Binding LeftDotX}" Canvas.Top="{Binding LeftDotY}" />
                                            </Canvas>
                                        </Border>
                                        <Border Width="72" Height="72" CornerRadius="36" Background="#2A2E35" Margin="12,0,0,0">
                                            <Canvas>
                                                <Ellipse Width="10" Height="10" Fill="#4C8DFF" Canvas.Left="{Binding RightDotX}" Canvas.Top="{Binding RightDotY}" />
                                            </Canvas>
                                        </Border>
                                        <StackPanel Width="130" Margin="18,0" VerticalAlignment="Center">
                                            <TextBlock Text="L2" Foreground="#9AA0A6" FontSize="12" />
                                            <ProgressBar Maximum="255" Value="{Binding L2, Mode=OneWay}" Height="8" />
                                            <TextBlock Text="R2" Foreground="#9AA0A6" FontSize="12" Margin="0,8,0,0" />
                                            <ProgressBar Maximum="255" Value="{Binding R2, Mode=OneWay}" Height="8" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ButtonsText}" Width="300" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <CheckBox Content="Oyunlara Xbox 360 pad'i olarak göster" IsChecked="{Binding IsEmulating}"
                                                  Foreground="#E8EAED" VerticalAlignment="Center" />
                                        <Button Content="Titreşim testi" Click="Rumble_Click" Margin="18,0,0,0" Padding="12,4" />
                                        <TextBlock Text="Işık:" Margin="18,0,6,0" VerticalAlignment="Center" Foreground="#9AA0A6" />
                                        <Button Width="24" Height="24" Margin="2,0" Background="#0040FF" Tag="#0040FF" Click="Color_Click" />
                                        <Button Width="24" Height="24" Margin="2,0" Background="#FF2020" Tag="#FF2020" Click="Color_Click" />
                                        <Button Width="24" Height="24" Margin="2,0" Background="#20D040" Tag="#20D040" Click="Color_Click" />
                                        <Button Width="24" Height="24" Margin="2,0" Background="#B030FF" Tag="#B030FF" Click="Color_Click" />
                                        <Button Width="24" Height="24" Margin="2,0" Background="#FFFFFF" Tag="#FFFFFF" Click="Color_Click" />
                                        <Button Width="24" Height="24" Margin="2,0" Background="#000000" Tag="#000000" Click="Color_Click" ToolTip="Işığı kapat" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding OutputStatus}" Foreground="#9AA0A6" FontSize="12" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
