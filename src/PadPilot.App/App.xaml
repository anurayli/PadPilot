<Application x:Class="PadPilot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PadPilot.App"
             ThemeMode="Dark" ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#14161B" />
        <SolidColorBrush x:Key="Sidebar" Color="#0F1115" />
        <SolidColorBrush x:Key="CardBg" Color="#1B1E25" />
        <SolidColorBrush x:Key="CardBorder" Color="#262A33" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8C94A3" />
        <SolidColorBrush x:Key="Text" Color="#E9EBEF" />
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />
        <SolidColorBrush x:Key="AccentSoft" Color="#1F3A6E" />
        <SolidColorBrush x:Key="Good" Color="#3DD68C" />
        <SolidColorBrush x:Key="Warn" Color="#FFB547" />
        <SolidColorBrush x:Key="Bad" Color="#FF5D6C" />
        <BooleanToVisibilityConverter x:Key="Vis" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Ac/kapa anahtari -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track" Width="42" Height="22" CornerRadius="11" Background="#2B303A" BorderBrush="#4A5160" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#C9CED8" HorizontalAlignment="Left" Margin="4,0,0,0" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ayar satiri: solda baslik + aciklama, sagda kontrol -->
        <Style TargetType="local:SettingRow">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SettingRow">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{TemplateBinding Title}" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                <TextBlock Text="{TemplateBinding Description}" Style="{StaticResource Muted}" x:Name="Desc" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Description" Value="{x:Null}">
                                <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kaydirici satiri -->
        <Style TargetType="local:SliderRow">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SliderRow">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="Desc" Grid.Row="1" Grid.ColumnSpan="3" Text="{TemplateBinding Description}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                    SmallChange="{TemplateBinding Step}" LargeChange="{TemplateBinding Step}" TickFrequency="{TemplateBinding Step}"
                                    IsSnapToTickEnabled="{TemplateBinding Snap}"
                                    Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding DisplayValue}" VerticalAlignment="Center" TextAlignment="Right"
                                       Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Description" Value="{x:Null}">
                                <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
    </Application.Resources>
</Application>
