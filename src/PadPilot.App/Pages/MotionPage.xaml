<UserControl x:Class="PadPilot.App.Pages.MotionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PadPilot.App">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel DataContext="{Binding Profile.Gyro}">
                <TextBlock Text="{local:L GyroAim}" Style="{StaticResource H2}" />
                <local:SettingRow Title="{local:L GyroUse}" Description="{local:L GyroUseDesc}">
                    <ComboBox ItemsSource="{x:Static local:Choices.GyroModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode}" Width="240" />
                </local:SettingRow>
                <local:SettingRow Title="{local:L GyroWhen}">
                    <ComboBox ItemsSource="{x:Static local:Choices.GyroActivations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Activation}" Width="240" />
                </local:SettingRow>
                <local:SettingRow Title="{local:L GyroButton}" Description="{local:L GyroButtonDesc}">
                    <ComboBox ItemsSource="{x:Static local:Choices.Buttons}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ActivationButton}" Width="240" />
                </local:SettingRow>
                <local:SettingRow Title="{local:L GyroAxisH}">
                    <ComboBox ItemsSource="{x:Static local:Choices.GyroAxes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Axis}" Width="240" />
                </local:SettingRow>
                <local:SliderRow Title="{local:L SensX}" Minimum="1" Maximum="40" Step="0.5" Format="0.0" Value="{Binding SensX}" Description="{local:L SensXDesc}" />
                <local:SliderRow Title="{local:L SensY}" Minimum="1" Maximum="40" Step="0.5" Format="0.0" Value="{Binding SensY}" />
                <local:SliderRow Title="{local:L Smoothing}" Minimum="0" Maximum="3" Step="0.1" Format="0.0" Value="{Binding Smoothing}" Description="{local:L SmoothingDesc}" />
                <local:SliderRow Title="{local:L StickGain}" Minimum="0.2" Maximum="3" Step="0.05" Format="x" Value="{Binding StickGain}" />
                <WrapPanel Margin="0,8,0,0">
                    <CheckBox Style="{StaticResource Switch}" Content="{local:L InvertH}" IsChecked="{Binding InvertX}" Margin="0,0,24,0" />
                    <CheckBox Style="{StaticResource Switch}" Content="{local:L InvertV}" IsChecked="{Binding InvertY}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{local:L Calibrate}" Click="Calibrate_Click" Style="{StaticResource AccentButton}" VerticalAlignment="Top" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{local:L Calibration}" Style="{StaticResource H2}" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Muted}" Text="{local:L CalibrationDesc}" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding SelectedPad.GyroText}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
