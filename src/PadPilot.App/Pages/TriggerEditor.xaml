<UserControl x:Class="PadPilot.App.Pages.TriggerEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PadPilot.App"
             x:Name="Root">
    <Border Style="{StaticResource Card}">
        <StackPanel DataContext="{Binding Settings, ElementName=Root}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LiveText, ElementName=Root}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource H2}" Margin="0" />
            </DockPanel>
            <local:TriggerPreview Margin="0,12,0,8" Value="{Binding Value, ElementName=Root}" Start="{Binding Start}" End="{Binding End}" Kind="{Binding Effect}" />

            <local:SliderRow Title="{local:L Deadzone}" Minimum="0" Maximum="0.5" Step="0.01" Format="%" Value="{Binding Deadzone}" Description="{local:L TrigDeadzoneDesc}" />
            <local:SliderRow Title="{local:L MaxZone}" Minimum="0.1" Maximum="1" Step="0.01" Format="%" Value="{Binding MaxZone}" Description="{local:L MaxZoneDesc}" />

            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{local:L DualSenseOnly}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="{local:L Adaptive}" FontWeight="SemiBold" />
                    </DockPanel>
                    <WrapPanel Margin="0,10,0,4">
                        <Button Style="{StaticResource Chip}" Content="{local:L PrOff}" Tag="off" Click="Preset_Click" />
                        <Button Style="{StaticResource Chip}" Content="{local:L PrPistol}" Tag="pistol" Click="Preset_Click" />
                        <Button Style="{StaticResource Chip}" Content="{local:L PrAuto}" Tag="auto" Click="Preset_Click" />
                        <Button Style="{StaticResource Chip}" Content="{local:L PrBow}" Tag="bow" Click="Preset_Click" />
                        <Button Style="{StaticResource Chip}" Content="{local:L PrBrake}" Tag="brake" Click="Preset_Click" />
                        <Button Style="{StaticResource Chip}" Content="{local:L PrGas}" Tag="gas" Click="Preset_Click" />
                        <Button Style="{StaticResource Chip}" Content="{local:L PrMachine}" Tag="machine" Click="Preset_Click" />
                        <Button Style="{StaticResource Chip}" Content="{local:L PrGallop}" Tag="gallop" Click="Preset_Click" />
                        <Button Style="{StaticResource Chip}" Content="{local:L PrHard}" Tag="hard" Click="Preset_Click" />
                    </WrapPanel>
                    <local:SettingRow Title="{local:L Effect}">
                        <ComboBox ItemsSource="{x:Static local:Choices.TriggerKinds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Effect}" Width="240" />
                    </local:SettingRow>
                    <local:SliderRow Title="{local:L StartPos}" Minimum="0" Maximum="9" Step="1" Snap="True" Format="0" Value="{Binding Start}" />
                    <local:SliderRow Title="{local:L EndPos}" Minimum="1" Maximum="9" Step="1" Snap="True" Format="0" Value="{Binding End}" />
                    <local:SliderRow Title="{local:L Strength}" Minimum="1" Maximum="8" Step="1" Snap="True" Format="0" Value="{Binding Strength}" />
                    <local:SliderRow Title="{local:L Snap}" Minimum="1" Maximum="8" Step="1" Snap="True" Format="0" Value="{Binding Snap}" Description="{local:L SnapDesc}" />
                    <local:SliderRow Title="{local:L Frequency}" Minimum="1" Maximum="40" Step="1" Snap="True" Format="0" Value="{Binding Frequency}" Description="{local:L FrequencyDesc}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
