<UserControl x:Class="PadPilot.App.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PadPilot.App">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" VerticalAlignment="Top" Padding="10,14">
            <StackPanel>
                <TextBlock Text="{local:L Profiles}" Style="{StaticResource H2}" Margin="10,0,0,8" />
                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Exes}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Margin="8,12,0,0">
                    <Button Style="{StaticResource Chip}" Content="{local:L New}" Click="New_Click" />
                    <Button Style="{StaticResource Chip}" Content="{local:L Copy}" Click="Duplicate_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{local:L Selected}" Style="{StaticResource H2}" />
                    <local:SettingRow Title="{local:L Name}">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="NameBox" Width="220" Text="{Binding Profile.Name, Mode=OneWay}" KeyDown="NameBox_KeyDown" />
                            <Button Content="{local:L Save}" Margin="8,0,0,0" Click="Rename_Click" />
                        </StackPanel>
                    </local:SettingRow>
                    <TextBlock x:Name="RenameError" Foreground="{StaticResource Bad}" FontSize="12.5" Visibility="Collapsed" Text="{local:L NameError}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource Chip}" Content="{local:L ResetProfile}" Click="Reset_Click" />
                        <Button Style="{StaticResource Chip}" Content="{local:L DeleteProfile}" Click="Delete_Click" Foreground="{StaticResource Bad}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Settings.AutoProfile}" VerticalAlignment="Center" />
                        <TextBlock Text="{local:L AutoProfile}" Style="{StaticResource H2}" Margin="0" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,10" Text="{local:L AutoProfileDesc}" />
                    <TextBox Text="{Binding Profile.Exes, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12" Text="{local:L ExesHint}" />
                    <TextBlock Text="{local:L Recent}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding RecentExes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Chip}" Content="{Binding}" Click="AddExe_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
