<UserControl x:Class="PadPilot.App.Pages.LightsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PadPilot.App">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel DataContext="{Binding Profile.Light}">
                <TextBlock Text="{local:L Lightbar}" Style="{StaticResource H2}" />
                <local:SettingRow Title="{local:L Mode}">
                    <ComboBox ItemsSource="{x:Static local:Choices.LightModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode}" Width="230" />
                </local:SettingRow>
                <local:SettingRow Title="{local:L Color}" Description="{local:L ColorDesc}">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{x:Static local:Choices.Swatches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="26" Height="26" Margin="3,0" Padding="0" Tag="{Binding}" Click="Swatch_Click" Cursor="Hand" ToolTip="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="13" Background="{Binding}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding Color, UpdateSourceTrigger=LostFocus}" Width="96" Margin="12,0,0,0" FontFamily="Cascadia Mono, Consolas" ToolTip="#RRGGBB" />
                    </StackPanel>
                </local:SettingRow>
                <local:SliderRow Title="{local:L Brightness}" Minimum="0.05" Maximum="1" Step="0.05" Format="%" Value="{Binding Brightness}" />
                <local:SettingRow Title="{local:L LowFlash}" Description="{local:L LowFlashDesc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LowBatteryFlash}" />
                </local:SettingRow>
                <local:SettingRow Title="{local:L PlayerLeds}" Description="{local:L PlayerLedsDesc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PlayerLeds}" />
                </local:SettingRow>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{local:L Rumble}" Style="{StaticResource H2}" />
                <local:SliderRow Title="{local:L RumbleStrength}" Minimum="0" Maximum="2" Step="0.05" Format="%" Value="{Binding Profile.Light.RumbleStrength}"
                                 Description="{local:L RumbleStrengthDesc}" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource Chip}" Content="{local:L Heavy}" Tag="strong" Click="Rumble_Click" />
                    <Button Style="{StaticResource Chip}" Content="{local:L LightMotor}" Tag="weak" Click="Rumble_Click" />
                    <Button Style="{StaticResource Chip}" Content="{local:L Both}" Tag="both" Click="Rumble_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
