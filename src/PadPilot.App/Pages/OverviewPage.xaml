<UserControl x:Class="PadPilot.App.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PadPilot.App">
    <StackPanel>
        <!-- Pad yok -->
        <Border Style="{StaticResource Card}" Padding="32" Visibility="{Binding NoPad, Converter={StaticResource Vis}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="56" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Pad bekleniyor" Style="{StaticResource H2}" HorizontalAlignment="Center" FontSize="20" Margin="0,14,0,6" />
                <TextBlock Style="{StaticResource Muted}" FontSize="13.5" TextAlignment="Center" MaxWidth="520"
                           Text="PS4 (DualShock 4) veya PS5 (DualSense) pad'ini USB kabloyla tak ya da Bluetooth'tan bağla. Bağlanınca kendiliğinden tanınır, ayar gerekmez." />
                <Border Background="{StaticResource Bg}" CornerRadius="10" Padding="18,14" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="İlk kez Bluetooth eşleştirme" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="1. PS5: Create + PS tuşlarına, PS4: Share + PS tuşlarına ışık yanıp sönene kadar 3 sn bas." />
                        <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="2. Windows Ayarlar → Bluetooth ve cihazlar → Cihaz ekle → Bluetooth → “Wireless Controller”." />
                        <Button Content="Bluetooth ayarlarını aç" Click="OpenBluetooth_Click" Margin="0,12,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Pad var -->
        <Grid Visibility="{Binding HasPad, Converter={StaticResource Vis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedPad.Info}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedPad.Name}" Style="{StaticResource H2}" FontSize="18" Margin="0" />
                    </DockPanel>
                    <local:PadVisual Height="300" Margin="0,16,0,8" State="{Binding SelectedPad.State}"
                                     IsDualSense="{Binding SelectedPad.IsDualSense}" Light="{Binding LightColor}" />
                    <TextBlock Text="{Binding SelectedPad.PressedText}" Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Durum" Style="{StaticResource H2}" />
                        <local:SettingRow Title="Pil">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedPad.BatteryIcon}" Style="{StaticResource Icon}" Foreground="{Binding SelectedPad.BatteryBrush}" />
                                <TextBlock Text="{Binding SelectedPad.BatteryLong}" Margin="8,0,0,0" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Title="Bağlantı">
                            <TextBlock Text="{Binding SelectedPad.Connection}" />
                        </local:SettingRow>
                        <local:SettingRow Title="Oyunlara görünüm">
                            <TextBlock Text="{Binding OutputText}" />
                        </local:SettingRow>
                        <local:SettingRow Title="Işık / titreşim">
                            <TextBlock Text="{Binding SelectedPad.OutputStatus}" Style="{StaticResource Muted}" MaxWidth="200" />
                        </local:SettingRow>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Hızlı işlemler" Style="{StaticResource H2}" />
                        <WrapPanel>
                            <Button Style="{StaticResource Chip}" Click="Rumble_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE877;" Style="{StaticResource Icon}" FontSize="14" /><TextBlock Text="Titreşim testi" Margin="8,0,0,0" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Chip}" Click="Calibrate_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7AD;" Style="{StaticResource Icon}" FontSize="14" /><TextBlock Text="Gyro kalibre et" Margin="8,0,0,0" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Chip}" Click="Disconnect_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="14" /><TextBlock Text="Pad'i kapat" Margin="8,0,0,0" /></StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock x:Name="ActionResult" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Hareket sensörü" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding SelectedPad.GyroText}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
