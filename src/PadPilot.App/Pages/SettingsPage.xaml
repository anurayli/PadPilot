<UserControl x:Class="PadPilot.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PadPilot.App">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <local:SettingRow Title="{local:L Language}" Description="{local:L LanguageDesc}">
                    <ComboBox ItemsSource="{x:Static local:Choices.Languages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Language}" Width="300" />
                </local:SettingRow>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel DataContext="{Binding Settings}">
                <TextBlock Text="{local:L HowGamesSee}" Style="{StaticResource H2}" />
                <local:SettingRow Title="{local:L OutputType}" Description="{local:L OutputTypeDesc}">
                    <ComboBox ItemsSource="{x:Static local:Choices.OutputKinds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Output}" Width="300" />
                </local:SettingRow>
                <local:SettingRow Title="{local:L HideReal}" Description="{local:L HideRealDesc}">
                    <CheckBox x:Name="HideSwitch" Style="{StaticResource Switch}" IsChecked="{Binding HideRealPads, Mode=OneWay}" Click="Hide_Click" />
                </local:SettingRow>
                <TextBlock x:Name="HideResult" Style="{StaticResource Muted}" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel DataContext="{Binding Settings}">
                <TextBlock Text="{local:L StartupWindow}" Style="{StaticResource H2}" />
                <local:SettingRow Title="{local:L StartWithWin}" Description="{local:L StartWithWinDesc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" Click="Startup_Click" />
                </local:SettingRow>
                <local:SettingRow Title="{local:L StartMin}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartMinimized}" />
                </local:SettingRow>
                <local:SettingRow Title="{local:L CloseTray}" Description="{local:L CloseTrayDesc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}" />
                </local:SettingRow>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel DataContext="{Binding Settings}">
                <TextBlock Text="{local:L BatteryPower}" Style="{StaticResource H2}" />
                <local:SliderRow Title="{local:L LowBattery}" Minimum="5" Maximum="50" Step="5" Snap="True" Format="0'%'" Value="{Binding LowBatteryWarn}" />
                <local:SliderRow Title="{local:L IdleOff}" Minimum="0" Maximum="60" Step="5" Snap="True" Format="0" Value="{Binding IdleDisconnectMinutes}" Description="{local:L IdleOffDesc}" />
                <local:SettingRow Title="{local:L PsOpt}" Description="{local:L PsOptDesc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PsOptionsDisconnect}" />
                </local:SettingRow>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{local:L DriversFiles}" Style="{StaticResource H2}" />
                <local:SettingRow Title="{local:L ViGEmName}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding DriverBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DriverStatus}" Margin="8,0,0,0" />
                    </StackPanel>
                </local:SettingRow>
                <local:SettingRow Title="{local:L HidHideName}">
                    <TextBlock Text="{Binding HidHideStatus}" />
                </local:SettingRow>
                <WrapPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource Chip}" Content="{local:L OpenFolder}" Click="OpenFolder_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{local:L Feedback}" Style="{StaticResource H2}" Margin="0,0,0,2" />
                <TextBlock Text="{local:L FeedbackDesc}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                <Grid>
                    <TextBox x:Name="FeedbackBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="260"
                             VerticalScrollBarVisibility="Auto" MaxLength="4000" TextChanged="Feedback_TextChanged" />
                    <TextBlock x:Name="FeedbackHint" Text="{local:L FeedbackPlaceholder}" Style="{StaticResource Muted}" FontSize="14" Margin="12,8,0,0" IsHitTestVisible="False"
                               />
                </Grid>
                <DockPanel Margin="0,10,0,0">
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Content="{local:L Send}" Style="{StaticResource AccentButton}" Click="SendFeedback_Click" Margin="12,0,0,0" />
                    <Grid>
                        <TextBox x:Name="FeedbackEmail" MaxLength="200" TextChanged="Feedback_TextChanged" />
                        <TextBlock x:Name="EmailHint" Text="{local:L FeedbackEmail}" Style="{StaticResource Muted}" FontSize="14" Margin="12,6,0,0" IsHitTestVisible="False"
                                   />
                    </Grid>
                </DockPanel>
                <TextBlock x:Name="FeedbackResult" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="/icon-256.png" Width="56" Height="56" VerticalAlignment="Top" Margin="0,2,18,0" />
                <StackPanel>
                    <TextBlock Text="{local:L About}" Style="{StaticResource H2}" Margin="0,0,0,6" />
                    <TextBlock>
                        <Run Text="PadPilot" FontWeight="SemiBold" /> <Run x:Name="VersionRun" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="{local:L Developer}" Foreground="{StaticResource MutedBrush}" /><Run Text=": " Foreground="{StaticResource MutedBrush}" /><Run Text="Ali Nuraylı" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Text="{local:L LicenseMit}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource Chip}" Content="{local:L OpenGitHub}" Tag="https://github.com/anurayli/PadPilot" Click="OpenUrl_Click" />
                        <Button Style="{StaticResource Chip}" Content="{local:L CheckUpdates}" Tag="https://github.com/anurayli/PadPilot/releases" Click="OpenUrl_Click" />
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
