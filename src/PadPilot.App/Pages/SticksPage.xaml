<UserControl x:Class="PadPilot.App.Pages.SticksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:PadPilot.App.Pages">
    <StackPanel>
        <pages:StickEditor Title="Sol analog" Settings="{Binding Profile.LeftStick}"
                           RawX="{Binding SelectedPad.RawLX}" RawY="{Binding SelectedPad.RawLY}"
                           OutX="{Binding SelectedPad.OutLX}" OutY="{Binding SelectedPad.OutLY}" />
        <pages:StickEditor Title="Sağ analog" Settings="{Binding Profile.RightStick}"
                           RawX="{Binding SelectedPad.RawRX}" RawY="{Binding SelectedPad.RawRY}"
                           OutX="{Binding SelectedPad.OutRX}" OutY="{Binding SelectedPad.OutRY}" />
    </StackPanel>
</UserControl>
